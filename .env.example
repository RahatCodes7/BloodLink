# BloodLink env template — কপি করে .env.local বানান, আসল value বসান।
# ⚠️ .env.local কখনো git-এ তুলবেন না।

# ---- Primary DB: CockroachDB (server-side only, NEXT_PUBLIC_ নয়) ----
DATABASE_URL=postgresql://USER:PASSWORD@HOST:26257/bloodlink?sslmode=require
DB_POOL_MAX=10

# ---- Auth: নিজের JWT ----
# 32+ random: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=CHANGE_ME_32_PLUS_RANDOM_CHARS

# ---- Firebase Phone Auth (apiKey public, NEXT_PUBLIC_ safe) ----
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# ---- Web Push (VAPID) — জরুরি নোটিফিকেশন ফোনে ----
# generate: node -e "console.log(require('web-push').generateVAPIDKeys())"
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@bloodlink.local

# ---- Site ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000
